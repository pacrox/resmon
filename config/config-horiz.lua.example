-- Full-featured example resmon configuration -- CPU Cores Graph, GPU Graph,
-- CLOCK Frequency Graph (CPU only), CLOCK Frequency Avg Graph, TEMP Graph,
-- CPU Pulse, GPU Monitor, Top Processes, laid out horizontally.
-- Copy to ~/.config/resmon/config.lua (or point --config-file at a copy of this).
-- See config.lua.example for a minimal starting point and a reference of
-- what each field ("name", "mod", "fetcher", "weight") does.
--
-- Note the sharing: "CPU_Cores" is fetched once below and read by both
-- cores_graph and pulse; "GPU_Top_AMD" is fetched once (a single amdgpu_top
-- process) and read by both gpu_graph and gpu.

return { -- >{
	orientation = "horizontal",

	fetchers = {
		{ name = "CPU_Cores", refresh = 0.33 },
		{ name = "GPU_Top_AMD", refresh = 0.5 },
		{ name = "CPU_Clock", refresh = 0.5 },
		{ name = "GPU_Clock_AMD", refresh = 0.5 },
		{ name = "CPU_Temp_AMD", refresh = 0.5 },
		{ name = "GPU_Temp_AMD", refresh = 0.5 },
		{ name = "TOP", refresh = 1.5 },
	},

	modules = {
		{ name = "cores_graph", mod = "cpu_cores_graph", weight = 1, fetcher = { "CPU_Cores" } },
		{ name = "gpu_graph", mod = "gpu_graph", weight = 1, fetcher = { "GPU_Top_AMD" } },
		{ name = "clock", mod = "clock_graph", weight = 1, fetcher = { "CPU_Clock" } },
		{ name = "clock_avg", mod = "clock_avg_graph", weight = 1, fetcher = { "CPU_Clock", "GPU_Clock_AMD" } },
		{ name = "temp", mod = "temp_graph", weight = 1, fetcher = { "CPU_Temp_AMD", "GPU_Temp_AMD" } },
		{ name = "pulse", mod = "cpu_pulse", weight = 1, fetcher = { "CPU_Cores" } },
		{ name = "gpu", mod = "gpu", weight = 1, fetcher = { "GPU_Top_AMD" } },
		{ name = "top", mod = "top", weight = 1, fetcher = { "TOP" } },
	},
} -- >}

-- vim: filetype=lua foldmethod=marker foldmarker=>{,>}
